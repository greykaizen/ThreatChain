@echo off
echo ========================================
echo Fix Column Error - Manual Setup
echo ========================================
echo.
echo This script will manually add the missing columns
echo to the stix_reports table.
echo.
pause

node -e "const db = require('./config/database'); (async () => { try { const connection = await db.getPool().getConnection(); console.log('Step 1: Checking current columns...'); const [columns] = await connection.execute(`DESCRIBE stix_reports`); console.log('Current columns:', columns.map(c => c.Field).join(', ')); console.log(''); console.log('Step 2: Adding organization_id column...'); try { await connection.execute(`ALTER TABLE stix_reports ADD COLUMN organization_id VARCHAR(36) NULL`); console.log('✅ organization_id column added'); } catch (e) { if (e.message.includes('Duplicate column')) { console.log('✅ organization_id column already exists'); } else { throw e; } } console.log(''); console.log('Step 3: Adding user_id column...'); try { await connection.execute(`ALTER TABLE stix_reports ADD COLUMN user_id VARCHAR(36) NULL`); console.log('✅ user_id column added'); } catch (e) { if (e.message.includes('Duplicate column')) { console.log('✅ user_id column already exists'); } else { throw e; } } console.log(''); console.log('Step 4: Adding indexes...'); try { await connection.execute(`CREATE INDEX idx_organization_id ON stix_reports(organization_id)`); console.log('✅ idx_organization_id index added'); } catch (e) { if (e.message.includes('Duplicate key')) { console.log('✅ idx_organization_id index already exists'); } else { console.log('⚠️ Index warning:', e.message); } } try { await connection.execute(`CREATE INDEX idx_user_id ON stix_reports(user_id)`); console.log('✅ idx_user_id index added'); } catch (e) { if (e.message.includes('Duplicate key')) { console.log('✅ idx_user_id index already exists'); } else { console.log('⚠️ Index warning:', e.message); } } console.log(''); console.log('Step 5: Verifying system organization exists...'); const [sysOrg] = await connection.execute(`SELECT * FROM organizations WHERE id = 'system-legacy'`); if (sysOrg.length === 0) { console.log('Creating system organization...'); await connection.execute(`INSERT INTO organizations (id, org_name, admin_first_name, admin_last_name, email, password_hash, status) VALUES ('system-legacy', 'System', 'System', 'Admin', 'system@threadchain.local', '$2b$10$dummyhash', 'active')`); console.log('✅ System organization created'); } else { console.log('✅ System organization already exists'); } console.log(''); console.log('Step 6: Updating legacy reports...'); const [result] = await connection.execute(`UPDATE stix_reports SET organization_id = 'system-legacy' WHERE organization_id IS NULL`); console.log(`✅ Updated ${result.affectedRows} legacy reports`); console.log(''); console.log('========================================'); console.log('✅ Fix Complete!'); console.log('========================================'); console.log(''); console.log('Verification:'); const [newColumns] = await connection.execute(`DESCRIBE stix_reports`); const hasOrgId = newColumns.some(c => c.Field === 'organization_id'); const hasUserId = newColumns.some(c => c.Field === 'user_id'); console.log(`organization_id column: ${hasOrgId ? '✅ Present' : '❌ Missing'}`); console.log(`user_id column: ${hasUserId ? '✅ Present' : '❌ Missing'}`); connection.release(); process.exit(0); } catch (error) { console.error('❌ Error:', error.message); console.error('Stack:', error.stack); process.exit(1); } })();"

echo.
echo Done! You can now restart your servers.
pause
