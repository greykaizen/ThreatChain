    {
      "id": "jwqKzviXIltkyOiwWo2be",
      "type": "text",
      "x": 10118.138474304418,
      "y": -1503.9079064344853,
      "width": 1340.928466796875,
      "height": 360,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2k",
      "roundness": null,
      "seed": 2085639036,
      "version": 54,
      "versionNonce": 555180028,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1759584465008,
      "link": null,
      "locked": false,
      "text": "Problems in existing parsers:\n\n1. No validation - output malformed STIX, bad IPs, wrong schemas\n2. No policy enforcement - ingest everything, no filtering rules\n3. Inconsistent metadata - different confidence/TLP mappings across tools\n4. Silent failures - parsing errors get ignored or logged poorly\n5. No transformation tracking - can't see what changed during conversion\n6. Format-specific - each tool has its own parser, no unified layer",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problems in existing parsers:\n\n1. No validation - output malformed STIX, bad IPs, wrong schemas\n2. No policy enforcement - ingest everything, no filtering rules\n3. Inconsistent metadata - different confidence/TLP mappings across tools\n4. Silent failures - parsing errors get ignored or logged poorly\n5. No transformation tracking - can't see what changed during conversion\n6. Format-specific - each tool has its own parser, no unified layer",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GZkKWU1PXYAzh_yvcx4Bm",
      "type": "text",
      "x": 8586.777134525786,
      "y": -563.9581467581254,
      "width": 693.4469472252113,
      "height": 315,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2l",
      "roundness": null,
      "seed": 1914274300,
      "version": 106,
      "versionNonce": 1361795908,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1759592203267,
      "link": null,
      "locked": false,
      "text": "openCTI\n- historical and new feeds are\nconverted to stix 2.1\n- Pull data from external sources\n(MISP, AlienVault, etc.)\nConvert to STIX 2.1\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "openCTI\n- historical and new feeds are converted to stix 2.1\n- Pull data from external sources (MISP, AlienVault, etc.)\nConvert to STIX 2.1\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "gADe4EU_lMJEF3UO2YDhp",
      "type": "text",
      "x": 9271.415212395332,
      "y": -551.6471843294286,
      "width": 741.6723022460938,
      "height": 135,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2m",
      "roundness": null,
      "seed": 1706848708,
      "version": 29,
      "versionNonce": 1903641284,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1759592210583,
      "link": null,
      "locked": false,
      "text": "They're tightly coupled to OpenCTI's API\nAssume OpenCTI as the destination\nNot standalone parsers you can reuse",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "They're tightly coupled to OpenCTI's API\nAssume OpenCTI as the destination\nNot standalone parsers you can reuse",
      "autoResize": true,
      "lineHeight": 1.25
    },
