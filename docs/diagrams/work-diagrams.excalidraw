    {
      "id": "v56XiTJwcNd7cFJGq4DiX",
      "type": "text",
      "x": 10991.84529832011,
      "y": 1129.5031632302462,
      "width": 447.6502952739607,
      "height": 32.95636856526199,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4wV",
      "roundness": null,
      "seed": 71382496,
      "version": 774,
      "versionNonce": 130441123,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760343500663,
      "link": null,
      "locked": false,
      "text": "build a modular system that automatically extracts all STIX 2.1 domain\nobjects (18 SDOs) and 100+ relation types from unstructured CTI reports.",
      "fontSize": 13.182547426104794,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "build a modular system that automatically extracts all STIX 2.1 domain objects (18 SDOs) and 100+ relation types from unstructured CTI reports.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "8lhJJxC7nS1u5PyblsH2W",
      "type": "text",
      "x": 10379.221130053358,
      "y": 1125.0338952302461,
      "width": 447.6502952739607,
      "height": 65.91273713052398,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4wW",
      "roundness": null,
      "seed": 1218358304,
      "version": 810,
      "versionNonce": 949943776,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760297680792,
      "link": null,
      "locked": false,
      "text": "efficiently mine tactics (ATT&CK tactics) from large-scale unstructured\ncybersecurity reports by designing a parallelized multi-label deep-forest\nclassifier (PDFMLC) and packaging it as PDFMLC-TIM that outputs STIX2.1\nformatted tactics intelligence",
      "fontSize": 13.182547426104794,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "efficiently mine tactics (ATT&CK tactics) from large-scale unstructured cybersecurity reports by designing a parallelized multi-label deep-forest classifier (PDFMLC) and packaging it as PDFMLC-TIM that outputs STIX2.1 formatted tactics intelligence",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "5TNepF7WFMTgE0IY6Mg0D",
      "type": "text",
      "x": 10991.84529832011,
      "y": 1366.8310192739098,
      "width": 447.6502952739607,
      "height": 115.34728997841698,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4wZ",
      "roundness": null,
      "seed": 2021302752,
      "version": 839,
      "versionNonce": 197161795,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760343500663,
      "link": null,
      "locked": false,
      "text": "entity extraction across 18 STIX types: Precision 0.903, Recall 0.935, F1\n0.916; KB rule baseline P 0.835 R 0.869 F1 0.846; novel-entity extractor\nalone P 0.927 R 0.854 F1 0.889. Relation extraction in standard eval: P\n0.721 R 0.753 F1 0.724; excluding relations with misclassified entities: P\n0.828 R 0.692 F1 0.733 (shows measured error propagation). Class-level\nF1s reported (examples: Campaign 0.409, Intrusion Set 0.941, Location\n0.936, Tool 0.698).",
      "fontSize": 13.182547426104794,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "entity extraction across 18 STIX types: Precision 0.903, Recall 0.935, F1 0.916; KB rule baseline P 0.835 R 0.869 F1 0.846; novel-entity extractor alone P 0.927 R 0.854 F1 0.889. Relation extraction in standard eval: P 0.721 R 0.753 F1 0.724; excluding relations with misclassified entities: P 0.828 R 0.692 F1 0.733 (shows measured error propagation). Class-level F1s reported (examples: Campaign 0.409, Intrusion Set 0.941, Location 0.936, Tool 0.698).",
      "autoResize": false,
      "lineHeight": 1.25
    },
