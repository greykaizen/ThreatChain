# MySQL — same credentials as the main app
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=threadchain_db
DB_PORT=3306

# RAG service port
RAG_PORT=5002

# LLM backend: "ollama" or "openai"
LLM_BACKEND=ollama

# If using Ollama (free, local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# If using OpenAI
OPENAI_API_KEY=

# Embedding model (HuggingFace, runs locally, no key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB persistence directory (relative to rag-service/)
CHROMA_PERSIST_DIR=./chroma_db
